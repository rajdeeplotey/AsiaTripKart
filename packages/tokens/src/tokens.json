{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "AsiaVoyage 'Jade & Saffron' design tokens. Single source of truth: build emits tokens.css (web), tailwind preset (web/admin) and this JSON (React Native). Contrast ratios are measured against the background noted; all text pairs meet WCAG 2.2 AA (4.5:1) unless marked large-text/non-text.",
  "color": {
    "brand": {
      "primary":     { "$value": "#0F6B5C", "$type": "color", "$description": "Jade 700. Logo, links, active nav, icons. 6.41:1 on white, 6.05:1 on surface-warm." },
      "primary-600": { "$value": "#13806E", "$type": "color", "$description": "Hover. 4.84:1 on white." },
      "primary-800": { "$value": "#0B5247", "$type": "color", "$description": "Pressed state, footer background." },
      "primary-50":  { "$value": "#E8F5F1", "$type": "color", "$description": "Tinted sections, chips. Primary text on it: 5.72:1." },
      "accent":      { "$value": "#F26B3A", "$type": "color", "$description": "Saffron Coral (brand). Decorative fills, icons, large display text ≥24px only. White on it is 3.03:1 — FAILS AA for normal text; do not use as a button fill with 16px white labels." },
      "accent-600":  { "$value": "#D9562A", "$type": "color", "$description": "Brand hover for decorative uses. White on it is 3.95:1 (fails for normal text)." },
      "accent-700":  { "$value": "#C4471B", "$type": "color", "$description": "CTA fill (Book now, Enquire, Plan my trip). White label 4.92:1 — passes AA." },
      "accent-800":  { "$value": "#A93C17", "$type": "color", "$description": "CTA hover/pressed." },
      "cta-label":   { "$value": "#FFFFFF", "$type": "color", "$description": "CTA label. Light: white on accent-700 (4.92:1). Dark: #111827." },
      "accent-text": { "$value": "#C2410C", "$type": "color", "$description": "Price highlights and accent text on white/warm. 5.18:1 on white." },
      "gold":        { "$value": "#E8B84A", "$type": "color", "$description": "Rating stars, Trending/Best-seller badge FILL. Always pair with ink-900 text (9.62:1). Never as text on white (1.84:1)." }
    },
    "ink": {
      "900": { "$value": "#111827", "$type": "color", "$description": "Headings." },
      "600": { "$value": "#4B5563", "$type": "color", "$description": "Body text. 7.56:1 on white." },
      "500": { "$value": "#6B7280", "$type": "color", "$description": "Captions, meta, strikethrough prices. 4.83:1 on white, 4.56:1 on surface-warm. Added: brief's ink-400 fails AA for text." },
      "400": { "$value": "#9CA3AF", "$type": "color", "$description": "Disabled, placeholder icons, decorative only. 2.54:1 — never for readable text." }
    },
    "surface": {
      "default": { "$value": "#FFFFFF", "$type": "color", "$description": "Cards, header, mega-menu." },
      "warm":    { "$value": "#FBF8F3", "$type": "color", "$description": "Page background, alternate sections, utility strip." },
      "overlay": { "$value": "rgba(17, 24, 39, 0.55)", "$type": "color", "$description": "Modal / drawer scrim." },
      "hero-gradient": { "$value": "radial-gradient(ellipse 80% 50% at 50% 55%, rgba(17,24,39,0.42) 0%, rgba(17,24,39,0.24) 60%, rgba(17,24,39,0) 100%), linear-gradient(180deg, rgba(17,24,39,0.45) 0%, rgba(17,24,39,0.10) 40%, rgba(17,24,39,0.65) 100%)", "$type": "gradient", "$description": "Top and bottom scrims plus a soft centre scrim behind the centred hero copy." }
    },
    "line": { "default": { "$value": "#ECE7DF", "$type": "color", "$description": "Borders, dividers (decorative)." }, "strong": { "$value": "#8C857A", "$type": "color", "$description": "Form-field borders: 3.65:1 non-text contrast (WCAG 1.4.11)." } },
    "feedback": {
      "success":      { "$value": "#16A34A", "$type": "color", "$description": "Icons / pill fills only (3.30:1 non-text)." },
      "success-text": { "$value": "#15803D", "$type": "color", "$description": "'Free cancellation', discount text. 5.02:1 on white." },
      "success-bg":   { "$value": "#F0FDF4", "$type": "color" },
      "danger":       { "$value": "#DC2626", "$type": "color", "$description": "Errors, sold out. 4.83:1 on white." },
      "danger-bg":    { "$value": "#FEF2F2", "$type": "color" },
      "focus-ring":   { "$value": "#0F6B5C", "$type": "color", "$description": "2px ring + 2px white offset." }
    }
  },
  "color-dark": {
    "$description": "Defined now, shipped later behind feature flag `theme.dark`.",
    "brand.primary":   { "$value": "#4FC3A9", "$type": "color" },
    "brand.accent-700":{ "$value": "#F2804F", "$type": "color", "$description": "CTA fill in dark." },
    "cta.label":       { "$value": "#111827", "$type": "color", "$description": "Dark-mode CTA label stays dark (ink-900 inverts to light in dark mode)." },
    "ink.900":         { "$value": "#F5F3EF", "$type": "color" },
    "ink.600":         { "$value": "#C9CDD3", "$type": "color" },
    "ink.500":         { "$value": "#9EA4AD", "$type": "color" },
    "surface.default": { "$value": "#161B22", "$type": "color" },
    "surface.warm":    { "$value": "#0F1318", "$type": "color" },
    "line.default":    { "$value": "#2A3038", "$type": "color" }
  },
  "font": {
    "family": {
      "display": { "$value": "'Playfair Display', Georgia, 'Times New Roman', serif", "$type": "fontFamily" },
      "body":    { "$value": "'Plus Jakarta Sans', Inter, system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 } },
    "size": {
      "$description": "Fluid: clamp(mobile, preferred, desktop). Desktop values match the brief: 56/44/32/24/20/16/14.",
      "display": { "$value": "clamp(2.25rem, 1.5rem + 3.2vw, 3.5rem)",  "lineHeight": 1.1,  "$description": "36 → 56px. Hero headline." },
      "h1":      { "$value": "clamp(1.875rem, 1.4rem + 2vw, 2.75rem)",  "lineHeight": 1.15, "$description": "30 → 44px" },
      "h2":      { "$value": "clamp(1.5rem, 1.2rem + 1.3vw, 2rem)",     "lineHeight": 1.2,  "$description": "24 → 32px" },
      "h3":      { "$value": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",  "lineHeight": 1.3,  "$description": "20 → 24px" },
      "h4":      { "$value": "clamp(1.125rem, 1.05rem + 0.3vw, 1.25rem)","lineHeight": 1.4, "$description": "18 → 20px" },
      "body":    { "$value": "1rem",     "lineHeight": 1.6, "$description": "16px" },
      "small":   { "$value": "0.875rem", "lineHeight": 1.5, "$description": "14px" },
      "micro":   { "$value": "0.75rem",  "lineHeight": 1.4, "$description": "12px. Badges only, semibold, uppercase tracking 0.04em." }
    }
  },
  "space": {
    "$description": "8px grid (4px half-step allowed for icon gaps).",
    "0": { "$value": "0" }, "0.5": { "$value": "4px" }, "1": { "$value": "8px" }, "2": { "$value": "16px" }, "3": { "$value": "24px" },
    "4": { "$value": "32px" }, "5": { "$value": "40px" }, "6": { "$value": "48px" }, "8": { "$value": "64px" }, "10": { "$value": "80px" },
    "12": { "$value": "96px" }, "16": { "$value": "128px" }
  },
  "layout": {
    "container-max": { "$value": "80rem" },
    "megamenu-max":  { "$value": "75rem" },
    "gutter-mobile": { "$value": "16px" },
    "gutter-desktop":{ "$value": "32px" },
    "header-utility-height": { "$value": "2.3125rem" },
    "header-height":         { "$value": "5rem" },
    "header-sticky-height":  { "$value": "4rem" },
    "header-solid-after-scroll": { "$value": "80px" },
    "bottom-tabbar-height":  { "$value": "64px" },
    "breakpoints": { "sm": { "$value": "360px" }, "md": { "$value": "768px" }, "lg": { "$value": "1024px" }, "xl": { "$value": "1280px" }, "2xl": { "$value": "1920px" } }
  },
  "radius": {
    "sm": { "$value": "8px" }, "md": { "$value": "12px" }, "card": { "$value": "16px" }, "panel": { "$value": "16px" }, "pill": { "$value": "999px" }
  },
  "shadow": {
    "card":     { "$value": "0 8px 24px rgba(17, 24, 39, 0.08)" },
    "card-hover": { "$value": "0 12px 32px rgba(17, 24, 39, 0.12)" },
    "header":   { "$value": "0 2px 12px rgba(17, 24, 39, 0.06)" },
    "panel":    { "$value": "0 24px 48px rgba(17, 24, 39, 0.12)" }
  },
  "motion": {
    "megamenu-open-intent": { "$value": "120ms" },
    "megamenu-close-delay": { "$value": "250ms" },
    "megamenu-swap":        { "$value": "150ms", "offset": "8px" },
    "nav-underline":        { "$value": "200ms" },
    "chevron-rotate":       { "$value": "200ms" },
    "easing-standard":      { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "easing-exit":          { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
    "$description": "All motion collapses to 0ms under prefers-reduced-motion."
  },
  "z": { "header": { "$value": 40 }, "megamenu": { "$value": 50 }, "drawer": { "$value": 60 }, "modal": { "$value": 70 }, "toast": { "$value": 80 } }
}
